import QtQuick

// Plain-language explanations of the sketch terms (ui-help.adoc).
QtObject {
    // Glossary order: concepts first, then the actions in context-bar order.
    readonly property var keys: [
        "constraint", "dimension", "dof", "defined", "redundant", "conflict",
        "snap", "finger", "autodim", "input", "modes",
        "coincident", "horizontal", "vertical", "parallel", "perpendicular",
        "tangent", "equal", "fix", "length", "distance", "angle", "radius"
    ]

    readonly property var entries: ({
        constraint: {
            title: qsTr("Ограничение"),
            hint: qsTr("Правило, которое чертёж соблюдает всегда"),
            text: qsTr("Ограничение — это правило для геометрии, которое программа соблюдает при любых изменениях. "
                       + "Например, «горизонтально» для линии: как бы вы ни тянули её конец, линия останется ровной. "
                       + "Ограничения добавляются кнопками внизу после выбора объектов и видны в списке справа.")
        },
        dimension: {
            title: qsTr("Управляющий размер"),
            hint: qsTr("Размер, который задаёт геометрию, а не только показывает её"),
            text: qsTr("Размер здесь — тоже ограничение, только с числом. «Длина 50» означает, что отрезок всегда 50 мм. "
                       + "Измените число на 75 — и чертёж перестроится сам. В обычном 2D-черчении размер лишь показывает "
                       + "то, что нарисовано; здесь он задаёт, каким чертёж должен быть.")
        },
        dof: {
            title: qsTr("Степени свободы (DOF)"),
            hint: qsTr("Сколькими способами чертёж ещё можно сдвинуть"),
            text: qsTr("DOF — сколько независимых движений осталось у чертежа, не нарушая ни одного правила. "
                       + "У свободного отрезка 4: каждый конец можно двигать по X и по Y. "
                       + "«Горизонтально» убирает одно движение (3), длина ещё одно (2), фиксация конца — последние два (0). "
                       + "Когда DOF 0, чертёж полностью определён и случайно его не испортить.")
        },
        defined: {
            title: qsTr("Полностью определён"),
            hint: qsTr("DOF 0: всё задано, двигать нечего"),
            text: qsTr("Все положения и размеры заданы правилами, свободных движений не осталось (DOF 0). "
                       + "Обычно к этому и стремятся: деталь описана однозначно.")
        },
        redundant: {
            title: qsTr("Избыточно"),
            hint: qsTr("Одно и то же правило задано дважды"),
            text: qsTr("Какое-то правило повторяет то, что уже следует из других. Например, две одинаковые длины "
                       + "на одном отрезке. Ошибки нет, но лишнее лучше удалить: при изменении одного значения "
                       + "второе начнёт мешать. Такие правила отмечены в списке справа.")
        },
        conflict: {
            title: qsTr("Конфликт"),
            hint: qsTr("Правила противоречат друг другу"),
            text: qsTr("Новое правило невозможно выполнить вместе с уже существующими. Например, обе точки линии "
                       + "закреплены на одной высоте, а вы просите сделать её вертикальной. "
                       + "Программа не применяет такое изменение, показывает сообщение и подсвечивает мешающие объекты красным.")
        },
        snap: {
            title: qsTr("Привязка"),
            hint: qsTr("Точки прилипают к сетке и к существующим точкам"),
            text: qsTr("Когда привязка включена, новые точки попадают точно на узлы сетки или на уже нарисованные точки. "
                       + "Так концы отрезков совпадают без лишних движений. Шаг сетки зависит от масштаба и показан внизу.")
        },
        finger: {
            title: qsTr("Палец рисует / двигает вид"),
            hint: qsTr("Что делает касание пальцем: рисует или сдвигает вид"),
            text: qsTr("На планшете палец может рисовать, как стилус, или только двигать и масштабировать вид — "
                       + "тогда рисуют стилусом или мышью. Переключатель на панели слева.")
        },
        autodim: {
            title: qsTr("Авторазмеры"),
            hint: qsTr("Новые фигуры сразу получают размеры"),
            text: qsTr("Когда авторазмеры включены, у новой линии сразу появляется её длина, у окружности и дуги — радиус, "
                       + "у прямоугольника — ширина и высота (и стороны остаются горизонтальными и вертикальными). "
                       + "Лишний размер, который уже следует из других правил, не ставится. Выключается в меню «⋮».")
        },
        input: {
            title: qsTr("Ввод значения при рисовании"),
            hint: qsTr("Наберите число, чтобы задать точную длину или радиус"),
            text: qsTr("Пока фигура рисуется, рядом с ней виден её размер. Наберите число на клавиатуре или нажмите на "
                       + "размер — откроется ввод. Линия получит эту длину в сторону курсора, окружность — этот радиус; "
                       + "у прямоугольника сначала вводится ширина, затем высота.")
        },
        modes: {
            title: qsTr("Деталь, Сборка, Чертёж"),
            hint: qsTr("Появится в версии 1.0"),
            text: qsTr("Сейчас доступен только эскиз. Объёмные детали, сборки и чертёжные листы появятся в версии 1.0.")
        },
        coincident: {
            title: qsTr("Совпадение"),
            hint: qsTr("Две точки всегда в одном месте"),
            text: qsTr("Выберите две точки: они сольются и дальше будут двигаться вместе. Так соединяют концы отрезков.")
        },
        horizontal: {
            title: qsTr("Горизонтально"),
            hint: qsTr("Линия (или две точки) всегда на одной высоте"),
            text: qsTr("Линия остаётся строго горизонтальной. Если потянуть её конец вверх, поднимется вся линия, а не наклонится.")
        },
        vertical: {
            title: qsTr("Вертикально"),
            hint: qsTr("Линия (или две точки) всегда строго вертикальна"),
            text: qsTr("Линия остаётся строго вертикальной; две точки — одна над другой.")
        },
        parallel: {
            title: qsTr("Параллельно"),
            hint: qsTr("Две линии всегда параллельны"),
            text: qsTr("Выберите две линии: повернёте одну — повернётся и другая.")
        },
        perpendicular: {
            title: qsTr("Перпендикулярно"),
            hint: qsTr("Две линии всегда под прямым углом"),
            text: qsTr("Выберите две линии: между ними всегда будет 90°.")
        },
        tangent: {
            title: qsTr("Касание"),
            hint: qsTr("Линия или окружность касается окружности"),
            text: qsTr("Линия и окружность (или две окружности) касаются в одной точке, без пересечения.")
        },
        equal: {
            title: qsTr("Равенство"),
            hint: qsTr("Одинаковая длина двух линий или радиус двух окружностей"),
            text: qsTr("Две линии всегда одной длины, две окружности — одного радиуса. Измените одну — изменится и другая.")
        },
        fix: {
            title: qsTr("Фиксация"),
            hint: qsTr("Точка закреплена на месте"),
            text: qsTr("Точка больше не двигается — от неё отталкивается весь остальной чертёж. "
                       + "Закреплённые точки закрашены.")
        },
        length: {
            title: qsTr("Длина"),
            hint: qsTr("Размер: длина отрезка"),
            text: qsTr("Задаёт длину отрезка в миллиметрах. Нажмите на число на чертеже, чтобы изменить его.")
        },
        distance: {
            title: qsTr("Расстояние"),
            hint: qsTr("Размер: расстояние между точками или от точки до линии"),
            text: qsTr("Задаёт расстояние между двумя точками или от точки до линии (по перпендикуляру) в миллиметрах.")
        },
        angle: {
            title: qsTr("Угол"),
            hint: qsTr("Размер: угол между двумя линиями"),
            text: qsTr("Задаёт угол между двумя линиями в градусах.")
        },
        radius: {
            title: qsTr("Радиус"),
            hint: qsTr("Размер: радиус окружности или дуги"),
            text: qsTr("Задаёт радиус окружности или дуги в миллиметрах (на чертеже — «R» и число).")
        }
    })

    function title(key) { return entries[key] ? entries[key].title : key }
    function hint(key) { return entries[key] ? entries[key].hint : "" }
    function text(key) { return entries[key] ? entries[key].text : "" }
}
